project Guard_Test is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tests");
   for Main use ("guard_smoke.adb");
   for Object_Dir use "test_obj";
   for Exec_Dir use "test_bin";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnata", "-gnato");
   end Compiler;
end Guard_Test;
